# em-agent (repos gym-system + the-kluster under workspaces/EM).
#   docker compose -p em-agent --env-file .env --env-file profiles/EM.env up -d agent-daemon
# Secrets (GH_TOKEN, API keys, TS_AUTHKEY) stay in .env, not here.
WORKSPACE=
WORKSPACE_PROFILE=EM
GCLOUD_PROFILE=EM
# the-kluster's kubeconfig is configs/kube/VTS.
KUBE_PROFILE=VTS
# No WireGuard: EM reaches its network over Tailscale.
WIREGUARD_PROFILE=none
CLAUDE_PROFILE=EM
TAILSCALE_ENABLE=1
TAILSCALE_PROFILE=EM
TAILSCALE_HOSTNAME=em-agent
