# go-agent. Mirrors how the running container was created.
#   docker compose -p go-agent --env-file .env --env-file profiles/GO.env up -d agent-daemon
# Secrets (GH_TOKEN, API keys, TS_AUTHKEY) stay in .env, not here.
WORKSPACE=
WORKSPACE_PROFILE=GO
GCLOUD_PROFILE=GO
KUBE_PROFILE=GO
WIREGUARD_PROFILE=GO
CLAUDE_PROFILE=GO
TAILSCALE_ENABLE=0
