# mi-agent (MobileInsight). Mirrors how the running container was created.
#   docker compose -p mi-agent --env-file .env --env-file profiles/MI.env up -d agent-daemon
# Secrets (GH_TOKEN, API keys, TS_AUTHKEY) stay in .env, not here.
WORKSPACE=
WORKSPACE_PROFILE=MI
GCLOUD_PROFILE=MI
KUBE_PROFILE=MI
WIREGUARD_PROFILE=MI
CLAUDE_PROFILE=MI
TAILSCALE_ENABLE=0
