# Pinned tool versions used by the Dockerfile.
# Bump these and rebuild to upgrade a toolchain.

# Node.js major track (NodeSource installs the latest 22.x patch).
NODE_MAJOR=22

# Python via deadsnakes PPA (Ubuntu 24.04 / noble).
PYTHON_VERSION=3.14

# Go toolchain (official tarball).
GO_VERSION=1.26.5

# kubectl release.
KUBECTL_VERSION=v1.36.3

# gcloud SDK and gh CLI track their distro "latest" channels.

# Claude Code (npm @anthropic-ai/claude-code). Matches the running fleet.
CLAUDE_CODE_VERSION=2.1.284

# tmux, built from the upstream release tarball (Ubuntu 24.04 ships 3.4).
TMUX_VERSION=3.7b

# Tailscale (official apt repo, pkgs.tailscale.com/stable).
TAILSCALE_VERSION=1.104.1

# solomonar (`sol`) is not versioned here: it is a prebuilt binary built from a
# local checkout by scripts/fetch-solomonar.sh (version = that checkout's HEAD).
#
# NOTE: these values are mirrored as ARG defaults in the Dockerfile; keep both
# in sync (or pass --build-arg).
