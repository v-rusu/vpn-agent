# Pinned tool versions used by the Dockerfile.
# Bump these and rebuild to upgrade a toolchain.

# Node.js major track (NodeSource installs the latest 22.x patch).
NODE_MAJOR=22

# Python via deadsnakes PPA (Ubuntu 24.04 / noble).
PYTHON_VERSION=3.14

# Go toolchain (official tarball).
GO_VERSION=1.26.5

# kubectl release.
KUBECTL_VERSION=v1.36.3

# gcloud SDK and gh CLI track their distro "latest" channels.
