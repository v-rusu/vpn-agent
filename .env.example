# Copy to .env and fill in. This file is loaded by docker compose for
# variable substitution; values are injected into the container environment.
# If you store API keys directly inside configs/opencode/opencode.json instead,
# you can leave these blank.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENCODE_API_KEY=
GEMINI_API_KEY=
CURSOR_API_KEY=

# GitHub: a classic Personal Access Token (ghp_...). Create one at:
#   https://github.com/settings/tokens  ->  "Tokens (classic)" -> Generate new
# Suggested scopes: repo, workflow, read:org (add gist if you use gists).
# With this set, both `gh` and `git` (clone/push private repos) work automatically.
GH_TOKEN=
GITHUB_TOKEN=

# Which project to mount at /workspace. Pick a profile dir under ./workspaces/
# (e.g. MI, GO), or set WORKSPACE to an absolute host path to mount
# something outside the repo. WORKSPACE_PROFILE defaults to MI.
WORKSPACE=
WORKSPACE_PROFILE=MI

# Per-tool profile selection. Each defaults to MI. Override per-run, e.g.:
#   KUBE_PROFILE=VTS docker compose run --rm agent
#
# - GCLOUD_PROFILE    -> subdir of configs/gcloud/            (e.g. MI, GO)
# - WIREGUARD_PROFILE -> configs/wireguard/<PROFILE>.conf      (e.g. MI, GO)
# - KUBE_PROFILE      -> file in configs/kube/                 (e.g. MI, GO)
GCLOUD_PROFILE=MI
WIREGUARD_PROFILE=MI
KUBE_PROFILE=MI
